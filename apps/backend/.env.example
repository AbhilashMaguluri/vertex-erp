####################################################
# GENERAL
####################################################
ENVIRONMENT=development
PROJECT_NAME=Student Counselling Management System
API_V1_STR=/api/v1
LOG_LEVEL=INFO

####################################################
# DATABASE (Neon PostgreSQL)
####################################################
# Get your connection string from https://console.neon.tech
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=

####################################################
# JWT
####################################################
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

####################################################
# COOKIES (refresh token transport)
####################################################
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

####################################################
# CORS
####################################################
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

####################################################
# CLOUDINARY (file storage)
# Sign up at https://cloudinary.com and find these
# under Settings > API Keys.
####################################################
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

####################################################
# RESEND (email delivery)
# Sign up at https://resend.com and create an API key.
# EMAIL_FROM must be a verified sender address/domain.
####################################################
RESEND_API_KEY=
EMAIL_FROM=

####################################################
# FILE UPLOADS
####################################################
MAX_FILE_SIZE_MB=10

####################################################
# ADMIN BOOTSTRAP
# Used only by `python -m app.scripts.seed` to create the
# first Admin account. force_password_change is set on
# that account regardless, so this password is temporary.
####################################################
INITIAL_ADMIN_EMAIL=admin@college.edu
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

####################################################
# VERTEX AI
# Vertex is the AI Agent & Chatbot for VertexERP.
# Get a Groq API key from https://console.groq.com
####################################################
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
