####################################################
# SCMS Frontend Environment Variables
####################################################

# API Base URL for backend communications
# In local development, leave empty — Vite proxy forwards /api/* to localhost:8000
# In production (e.g. Vercel → Render): leave empty too — vercel.json rewrites
# handle the proxy. Only set this if you need to bypass the proxy:
#   VITE_API_URL=https://vertex-erp-backend.onrender.com/api/v1
VITE_API_URL=
