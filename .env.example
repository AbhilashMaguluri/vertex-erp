# General
PROJECT_NAME="Student Counselling Management System"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scms_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scms_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@scms.edu
EMAILS_FROM_NAME="SCMS System"
